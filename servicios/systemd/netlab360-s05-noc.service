# NETLAB360 | Gestión de servicios del laboratorio
# Configuración del componente correspondiente; conservar los recursos ajenos.
[Unit]
Description=NETLAB360 S05 NOC topologia e inspeccion FIB (solo lectura)
Wants=network-online.target netlab360-s04-exporter.service
After=network-online.target netlab360-s04-exporter.service
ConditionPathExists=/usr/local/libexec/netlab360-observer

[Service]
Type=simple
User=rc-aa-ec
WorkingDirectory=/home/rc-aa-ec/proyectos/netlab360
Environment=HOME=/home/rc-aa-ec
Environment=PYTHONUNBUFFERED=1
Environment=NETLAB360_PRIV_OBSERVER=/usr/local/libexec/netlab360-observer
ExecStart=/usr/bin/python3 /home/rc-aa-ec/proyectos/netlab360/servicios/topologia-s05/app.py --serve --port 9130
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
KillMode=control-group
UMask=0027
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
