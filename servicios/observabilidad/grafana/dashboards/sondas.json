          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duración de sonda",
      "description": "Duración total de Blackbox, no RTT.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false,
            "insertNulls": 15000,
            "showPoints": "never",
            "fillOpacity": 8,
            "axisSoftMin": 0
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"netlab360-s08-blackbox\"} * 1000",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Código HTTP observado",
      "description": "Código de respuesta; 0 puede indicar ausencia de respuesta HTTP.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false,
            "insertNulls": 15000,
            "showPoints": "never",
            "fillOpacity": 0,
            "axisSoftMin": 0,
            "lineInterpolation": "stepAfter",
            "axisSoftMax": 500
          },
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "blue",
                "value": 100
              },
              {
                "color": "green",
                "value": 200
              },
              {
                "color": "blue",
                "value": 300
              },
              {
                "color": "orange",
                "value": 400
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin respuesta HTTP",
                  "color": "gray",
                  "index": 0
                },
                "200": {
                  "text": "200 OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Sin datos",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "probe_http_status_code{job=\"netlab360-s08-blackbox\"}",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "SLI observado · 5 min",
      "description": "SLI sobre muestras medidas. Azul: valor observado ≥99 % (referencia provisional); no implica cobertura completa ni cumplimiento SLO. Consultar cobertura contigua.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "blue",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 23
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "100 * sum_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m]) / count_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m])",
          "legendFormat": "{{probe_id}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
    {
