{
  "uid": "netlab360-s08-observacion",
  "title": "NETLAB360 · Observabilidad de sondas",
  "description": "Vista especializada de la fuente Prometheus. No sustituye el portal operacional ni su evaluación de calidad.",
  "tags": [
    "netlab360",
    "observabilidad"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad de adquisición",
      "description": "1 = scrape correcto; ausencia no equivale a fallo medido.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "up{job=\"netlab360-s08-blackbox\"}",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Éxito de sonda",
      "description": "Resultado de sonda medido; no interpolar ausencias.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "probe_success{job=\"netlab360-s08-blackbox\"}",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duración de sonda",
      "description": "Duración total de Blackbox, no RTT.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"netlab360-s08-blackbox\"} * 1000",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Código HTTP observado",
      "description": "Código de respuesta; 0 puede indicar ausencia de respuesta HTTP.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
