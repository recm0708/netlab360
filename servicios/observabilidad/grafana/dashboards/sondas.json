          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "SLI observado · 5 min",
      "description": "Porcentaje sobre muestras medidas; no certifica cobertura ni cumplimiento SLO.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "100 * sum_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m]) / count_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m])",
          "legendFormat": "{{probe_id}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ]
    },
