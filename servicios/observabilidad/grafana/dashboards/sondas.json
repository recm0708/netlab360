        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "C",
          "expr": "count_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m])",
          "legendFormat": "{{probe_id}} medidas",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "D",
          "expr": "sum_over_time(probe_success{job=\"netlab360-s08-blackbox\"}[5m])",
          "legendFormat": "{{probe_id}} éxitos",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Metric",
            "format": "regexp",
            "regExp": "/^(?<Sonda>[a-z0-9-]+) (?<Contador>adquisición correcta|adquisición|medidas|éxitos)$/",
            "replace": false
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "Sonda",
            "columnField": "Contador",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Sonda\\Contador": 0,
              "adquisición": 1,
              "adquisición correcta": 2,
              "medidas": 3,
              "éxitos": 4
            },
            "renameByName": {
              "Sonda\\Contador": "Sonda",
              "adquisición": "Adquiridas",
              "adquisición correcta": "Adq. correctas",
              "medidas": "Medidas",
              "éxitos": "Éxitos"
            }
          }
        }
      ]
    },
