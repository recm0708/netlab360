{
  "uid": "netlab360-s08-observacion",
  "title": "NETLAB360 · Observabilidad de sondas",
  "description": "Vista especializada de Prometheus. Hora de Panamá (UTC−5). SLI observado y cobertura se interpretan por separado; no sustituye el portal operacional.",
  "tags": [
    "netlab360",
    "observabilidad"
  ],
  "timezone": "America/Panama",
  "editable": false,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad de adquisición",
      "description": "1 = scrape correcto; ausencia no equivale a fallo medido.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": 15000
          },
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Error de adquisición",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Adquisición OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Sin datos",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.75,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netlab360-prometheus"
          },
          "refId": "A",
          "expr": "up{job=\"netlab360-s08-blackbox\"}",
          "legendFormat": "{{probe_id}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Éxito de sonda",
      "description": "Resultado de sonda medido; no interpolar ausencias.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "netlab360-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
