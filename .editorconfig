# NETLAB360 — Formato compartido de código y documentos
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.tf]
indent_size = 2

[*.html]
indent_size = 2

[Makefile]
indent_style = tab
