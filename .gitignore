# Python runtime/bytecode files generated by NETLAB360 validation.
# These are disposable and must never be part of Git commits.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environments and build output.
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Local credentials, machine caches and downloaded evidence archives.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.log
*.pid
*.tmp

# OpenTofu: estado, planes, metadatos locales nunca en el repositorio.
*.tfstate
*.tfstate.*
*.tfplan
*.plan
.terraform/
.terraform.lock.hcl
