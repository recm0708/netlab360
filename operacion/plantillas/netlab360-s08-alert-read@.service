# Consulta fija de SQLite con la identidad propietaria del registro.
[Unit]
Description=NETLAB360 consulta de notificaciones

[Service]
Type=exec
User=netlab360-s08-alerts
Group=netlab360-s08-alerts
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/netlab360/s08-alertas/consultar_alertas.py
StandardInput=socket
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/netlab360/s08-alertas
ReadOnlyPaths=/var/lib/netlab360/s08-alertas/notificaciones.sqlite3
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
RuntimeMaxSec=15
TimeoutStopSec=3
LimitCORE=0
